{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "Community rendition of a ninth combat snapshot",
  "authors": [
    "Laxystem"
  ],
  "contact": {
    "sources": "https://github.com/Laxystem/Laxombat"
  },
  "license": "MPL-2.0",
  "icon": "assets/laxombat/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      {
        "adapter": "kotlin",
        "value": "quest.laxla.laxombat.fabric.LaxombatFabric"
      }
    ],
    "client": [
      {
        "adapter": "kotlin",
        "value": "quest.laxla.laxombat.fabric.client.LaxombatFabricClient"
      }
    ],
    "fabric-datagen": [
      {
        "adapter": "kotlin",
        "value": "quest.laxla.laxombat.datagen.LaxombatDataGenerator"
      }
    ]
  },
  "mixins": [
    "laxombat.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=25",
    "architectury": ">=${architectury}",
    "fabric-api": "*",
    "fabric-language-kotlin": ">=${flk}"
  },
  "suggests": {
    "another-mod": "*"
  }
}
